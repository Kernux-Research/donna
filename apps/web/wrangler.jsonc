{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "donna-web",
	"compatibility_date": "2026-06-04",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	}
}
