# Copy to .env for local development; set production secrets with Wrangler.
DONNA_API_TOKEN=replace-with-random-secret
DONNA_WEB_ORIGIN=http://localhost:5173
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-cloudflare-access-app-audience
DONNA_OWNER_EMAIL=your-existing-owner-email@example.com
# Generate once with: node -p 'require("node:crypto").randomBytes(32).toString("base64")'
# Keep this key unchanged across deployments; losing it makes saved user keys unreadable.
SETTINGS_ENCRYPTION_KEY=replace-with-generated-32-byte-base64-key
# Legacy owner-only fallback, never used for other Access users.
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=replace-with-provider-key
OPENAI_MODEL=your-model-id
