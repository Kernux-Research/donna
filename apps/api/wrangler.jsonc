{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "donna-api",
	"main": "src/donna-api.app.ts",
	"compatibility_date": "2026-06-04",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"logpush": true,
	"routes": [{ "pattern": "donna-api.kernux.org", "custom_domain": true }],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1 // 100%
		}
	},
	"placement": {
		"mode": "smart"
	},
	"vars": {
		"ENVIRONMENT": "development", // overridden during deployment
		"RELEASE": "unknown", // overridden during deployment
		"NAME": "donna-api"
	},
	"durable_objects": {
		"bindings": [{ "name": "DONNA_THREADS", "class_name": "DonnaThreads" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DonnaThreads"] }],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"upload_source_maps": true
}
